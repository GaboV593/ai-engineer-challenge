# auto: usa Azure si hay credenciales, si no FakeLLM. Valores: auto | azure | fake
LLM_PROVIDER=auto
AZURE_OPENAI_ENDPOINT=https://<recurso>.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini-1
# Tarifas USD por 1M tokens (para el costo en auditoría)
LLM_PRICE_INPUT_PER_1M=0.40
LLM_PRICE_OUTPUT_PER_1M=1.60
AUDIT_LOG_PATH=logs/audit.jsonl
